FLASK_ENV=development
SECRET_KEY=zmien-ten-klucz-na-losowy
APP_NAME=SP2 ADMIN
APP_VERSION=6.0.0-dev.3
APP_AUTHOR=Mariusz Klejno
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///instance/sp2-admin.sqlite3
SESSION_COOKIE_SECURE=false

# Samba AD / LDAP — konto techniczne tylko do odczytu
# Przykład URI bez TLS: ldap://192.168.0.10:389
# Przykład LDAPS: ldaps://dc01.szkola.local:636 oraz LDAP_USE_SSL=true
LDAP_URI=ldap://127.0.0.1:389
LDAP_BIND_DN=CN=sp2-admin-read,OU=Service Accounts,DC=szkola,DC=local
LDAP_BIND_PASSWORD=UZUPELNIJ_HASLO
LDAP_BASE_DN=DC=szkola,DC=local
LDAP_USE_SSL=false
LDAP_CONNECT_TIMEOUT=5
LDAP_RECEIVE_TIMEOUT=15
LDAP_PAGE_SIZE=500

# Osobne konto serwisowe do operacji zapisu w AD. Nie używaj konta odczytowego.
LDAP_WRITE_BIND_DN=
LDAP_WRITE_BIND_PASSWORD=
AD_PASSWORD_MIN_LENGTH=12
# Hasło początkowe przy tworzeniu konta wymaga zmiany przy pierwszym logowaniu,
# więc może być krótsze niż próg resetu hasła.
AD_NEW_USER_PASSWORD_MIN_LENGTH=6

# Agent Windows
AGENT_API_TOKEN=ZMIEN_NA_DLUGI_LOSOWY_TOKEN
AGENT_OFFLINE_AFTER_SECONDS=180
# Próg zajętości dysku lokalnego (%), po przekroczeniu którego komputer
# trafia na listę ostrzeżeń na dashboardzie.
AGENT_DISK_WARNING_PERCENT_USED=90

# Docelowe OU używane przez moduł Nauczyciele i kreator nazw komputerów
# AD_JOIN_ALLOWED_OU_BASES oddzielaj znakiem |
AD_JOIN_ALLOWED_OU_BASES=OU=Komputery,DC=szkola,DC=local
AD_TEACHER_USER_OU=OU=Nauczyciele,OU=Uzytkownicy,DC=szkola,DC=local
AD_TEACHER_COMPUTER_OU=OU=Nauczyciele,OU=Komputery,DC=szkola,DC=local

# Radiowęzeł — lokalne wyjście audio 3,5 mm serwera
# Włącz dopiero po instalacji mpv i sprawdzeniu głośności wzmacniacza.
RADIO_PLAYBACK_ENABLED=false
RADIO_BELL_AUTOMATION_ENABLED=false
RADIO_PLAYER_BINARY=mpv
RADIO_AUDIO_DEVICE=auto
RADIO_TTS_BINARY=espeak-ng
RADIO_TTS_VOICE=pl
RADIO_TTS_SPEED=165
RADIO_UPLOAD_MAX_BYTES=52428800

# QNAP / SMB — nazwa=adres, kolejne urządzenia oddzielaj znakiem |
# Ten etap tylko sprawdza dostępność portu SMB 445; nie przechowuje haseł.
NETWORK_DRIVE_ENDPOINTS=QNAP-A=192.168.0.188|QNAP-B=192.168.0.203
NETWORK_DRIVE_SMB_TIMEOUT=1.5
# Enable only after isolated Windows/Samba acceptance with NTLM disabled.
MACHINE_ACCOUNT_RECOVERY_ENABLED=false
# Oczekiwane powiązania udział=grupaAD, kolejne pary oddzielaj znakiem |.
# Audyt tylko do odczytu: sprawdza, czy grupa istnieje w AD i ma członków —
# nie weryfikuje uprawnień na samym NAS (brak do tego osobnych poświadczeń).
NETWORK_DRIVE_SHARE_GROUPS=Nauczyciele=G-Nauczyciele|Uczniowie=G-Uczniowie
